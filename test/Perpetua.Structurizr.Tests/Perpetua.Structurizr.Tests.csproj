<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers" Version="4.16.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Perpetua\Perpetua.csproj" />
    <ProjectReference Include="..\..\src\Perpetua.Structurizr\Perpetua.Structurizr.csproj" />
    <ProjectReference Include="..\Perpetua.Structurizr.Tests.Fixtures\Perpetua.Structurizr.Tests.Fixtures.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyFixtureAssemblies" AfterTargets="Build">
    <ItemGroup>
      <FixtureAssemblies Include="$(MSBuildThisFileDirectory)..\Perpetua.Structurizr.Tests.Fixtures\bin\$(Configuration)\$(TargetFramework)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FixtureAssemblies)" DestinationFolder="$(OutDir)fixtures" SkipUnchangedFiles="true" />
  </Target>

</Project>
